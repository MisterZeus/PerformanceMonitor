<Window x:Class="PerformanceMonitorLite.Windows.TagNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag"
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/EDD.ico"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundDarkBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Grid.Row="0"
                   Text="Tag name:" Margin="0,0,0,6"
                   Foreground="{DynamicResource ForegroundBrush}"/>

        <TextBox x:Name="NameBox" Grid.Row="1"
                 Padding="4" MaxLength="100"
                 Background="{DynamicResource BackgroundBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_OK" Width="76" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="_Cancel" Width="76" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
