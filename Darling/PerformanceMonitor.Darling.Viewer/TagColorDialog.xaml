<Window x:Class="PerformanceMonitor.Darling.Viewer.TagColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Colour"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundDarkBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Pick a colour for this tag:" Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"/>
        <WrapPanel x:Name="SwatchPanel" Width="272"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="DefaultButton" Content="_No colour" Width="90" Margin="0,0,6,0"
                    Padding="8,4" Click="Default_Click"/>
            <Button Content="_Cancel" Width="80" IsCancel="True" Padding="8,4"/>
        </StackPanel>
    </StackPanel>
</Window>
