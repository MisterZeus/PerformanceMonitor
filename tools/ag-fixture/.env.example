# Copy this file to .env in the same directory before running setup.ps1.
#
# .env is gitignored. These credentials are FIXTURE-LOCAL: they protect two
# throwaway containers bound to loopback. Do not reuse them anywhere real, and
# do not point this fixture at anything that matters.

# sa password for BOTH containers. Must satisfy the SQL Server password policy
# (8+ chars, three of: upper, lower, digit, symbol) or the containers exit on start.
MSSQL_SA_PASSWORD=REPLACE_ME_Str0ng!Passw0rd

# Protects the AG database master key and the exported endpoint certificate
# private key. Same policy applies.
AG_CERT_PASSWORD=REPLACE_ME_C3rt!Passw0rd
